#!/bin/sh

SCRIPT="/oem/printer_data/u1_wled/u1_wled.py"
LOG="/oem/printer_data/u1_wled/u1_wled.log"
PIDFILE="/var/run/u1_wled.pid"

is_running() {
    [ -f "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$PID" ] || return 1
    kill -0 "$PID" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then
            echo "U1 WLED bridge already running (PID $(cat "$PIDFILE"))"
            exit 0
        fi

        rm -f "$PIDFILE"
        echo "Starting U1 WLED bridge"
        nohup python3 "$SCRIPT" >> "$LOG" 2>&1 </dev/null &
        echo $! > "$PIDFILE"
        ;;

    stop)
        echo "Stopping U1 WLED bridge"
        if is_running; then
            kill "$(cat "$PIDFILE")" 2>/dev/null
        fi
        rm -f "$PIDFILE"
        ;;

    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;

    status)
        if is_running; then
            echo "U1 WLED IS RUNNING (PID $(cat "$PIDFILE"))"
            exit 0
        fi
        echo "U1 WLED IS NOT RUNNING"
        exit 1
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
