#!/bin/sh

SCRIPT="/oem/printer_data/u1_wled/u1_wled.py"
LOG="/oem/printer_data/u1_wled/u1_wled.log"
PIDFILE="/var/run/u1_wled.pid"

start_bridge() {
    echo "Starting U1 WLED bridge"

    if [ -f "$PIDFILE" ]; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            echo "U1 WLED bridge already running (PID $PID)"
            return 0
        fi
        rm -f "$PIDFILE"
    fi

    nohup python3 "$SCRIPT" >> "$LOG" 2>&1 </dev/null &
    echo $! > "$PIDFILE"
}

stop_process() {
    # Stop the PID recorded by the service, if present.
    if [ -f "$PIDFILE" ]; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"
        [ -n "$PID" ] && kill "$PID" 2>/dev/null
        rm -f "$PIDFILE"
    fi

    # Clean up any extra bridge copies left by the old S99 boot hook.
    for PID in $(ps | grep "[p]ython3 $SCRIPT" | awk '{print $1}'); do
        kill "$PID" 2>/dev/null
    done

    sleep 1
}

case "$1" in
    start)
        start_bridge
        ;;

    stop)
        echo "Stopping U1 WLED bridge"
        stop_process

        echo "Turning WLED LEDs off"
        python3 "$SCRIPT" --off >> "$LOG" 2>&1
        ;;

    restart)
        echo "Restarting U1 WLED bridge"
        # A service restart is maintenance, not a printer shutdown.
        # Stop the process without intentionally turning WLED off.
        stop_process
        start_bridge
        ;;

    status)
        if [ -f "$PIDFILE" ]; then
            PID="$(cat "$PIDFILE" 2>/dev/null)"
            if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
                echo "U1 WLED IS RUNNING (PID $PID)"
                exit 0
            fi
        fi
        echo "U1 WLED IS NOT RUNNING"
        exit 1
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
