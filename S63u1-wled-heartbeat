#!/bin/sh

SCRIPT="/oem/printer_data/u1_wled/u1_wled_heartbeat.py"
LOG="/oem/printer_data/u1_wled/u1_wled_heartbeat.log"
PIDFILE="/var/run/u1_wled_heartbeat.pid"

is_running() {
    [ -f "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$PID" ] || return 1
    kill -0 "$PID" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then
            echo "U1 WLED heartbeat is already running (PID $(cat "$PIDFILE"))"
            exit 0
        fi

        if [ ! -f "$SCRIPT" ]; then
            echo "Heartbeat script not found: $SCRIPT"
            exit 1
        fi

        echo "Starting U1 WLED heartbeat"
        nohup python3 "$SCRIPT" >> "$LOG" 2>&1 </dev/null &
        echo $! > "$PIDFILE"
        ;;

    stop)
        echo "Stopping U1 WLED heartbeat"
        if is_running; then
            kill "$(cat "$PIDFILE")" 2>/dev/null
        fi
        rm -f "$PIDFILE"
        ;;

    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;

    status)
        if is_running; then
            echo "U1 WLED HEARTBEAT IS RUNNING (PID $(cat "$PIDFILE"))"
            exit 0
        else
            echo "U1 WLED HEARTBEAT IS NOT RUNNING"
            exit 1
        fi
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
